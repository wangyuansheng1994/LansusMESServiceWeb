{
  "name": "lansus-mes-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LansusMESServiceWeb：LansusMES 前后端分离前端工程（React 19 + antd 6）——老 JSP 逐页迁移的新外壳与迁移期页面",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:mes": "tsc --noEmit && vite build --mode mes",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.104.2",
    "antd": "6.6.6",
    "axios": "1.20.0",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,html,json}": [
      "prettier --write"
    ]
  }
}
